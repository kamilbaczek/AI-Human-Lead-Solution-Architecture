  "create": [
    {
      "id": "create/single-option-prompt",
      "skill": "adr-create",
      "prompt": "Write an ADR: we are standardising on PostgreSQL for the new reporting service. It is the only option we are considering. Print the full ADR, do not save it.",
      "mustMatch": [
        "status quo|do nothing",
        "reversib",
        "quality attribute"
      ],
      "mustNotMatch": [
        "[\\uD83C-\\uD83E][\\uDC00-\\uDFFF]|[\\u2600-\\u27BF]"
      ]
    },
    {
      "id": "create/no-invented-data",
      "skill": "adr-create",
      "prompt": "Write an ADR for moving our job queue from Hangfire to Azure Service Bus. I have no benchmarks or cost figures. Print the full ADR, do not save it.",
      "mustMatch": [
        "todo",
        "status quo|do nothing",
        "reversib"
      ],
      "mustNotMatch": [
        "\\d+\\s?ms faster",
        "\\$\\d{3,}",
        "[\\uD83C-\\uD83E][\\uDC00-\\uDFFF]|[\\u2600-\\u27BF]"
      ]
    },
    {
